{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "module": "CommonJS", // ← changer
    "moduleResolution": "node", // ← changer
    "target": "ES2023",
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*"]
}
